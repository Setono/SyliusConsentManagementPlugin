{
    "name": "setono/sylius-consent-management-plugin",
    "description": "Handle consent (e.g. cookie) in your Sylius store",
    "license": "proprietary",
    "type": "sylius-plugin",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "doctrine/orm": "^2.6",
        "fakerphp/faker": "^1.23",
        "knplabs/knp-menu": "^3.4",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0",
        "setono/bot-detection-bundle": "^1.10",
        "setono/client-id-bundle": "^0.2.2",
        "setono/client-id-contracts": "^0.2",
        "setono/consent-bundle": "^0.1",
        "setono/consent-contracts": "^0.1.3",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sylius/resource-bundle": "^1.8",
        "symfony/config": "^5.4 || ^6.0",
        "symfony/dependency-injection": "^5.4 || ^6.0",
        "symfony/doctrine-bridge": "^5.4 || ^6.0",
        "symfony/event-dispatcher": "^5.4 || ^6.0",
        "symfony/form": "^5.4 || ^6.0",
        "symfony/http-foundation": "^5.4 || ^6.0",
        "symfony/http-kernel": "^5.4 || ^6.0",
        "symfony/mailer": "^5.4 || ^6.0",
        "symfony/options-resolver": "^5.4 || ^6.0",
        "symfony/routing": "^5.4 || ^6.0",
        "symfony/security-bundle": "^5.4 || ^6.0",
        "symfony/translation-contracts": "^1.1 || ^2.5 || ^3.1",
        "twig/twig": "^2.15",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/core": "^2.7",
        "doctrine/data-fixtures": "^1.5",
        "infection/infection": "^0.27",
        "lexik/jwt-authentication-bundle": "^2.16",
        "matthiasnoback/symfony-config-test": "^4.3",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^9.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "psalm/plugin-phpunit": "^0.18",
        "psalm/plugin-symfony": "^5.0",
        "setono/code-quality-pack": "^2.5",
        "setono/sylius-behat-pack": "^0.2.2",
        "sylius/sylius": "~1.12.3",
        "symfony/debug-bundle": "^5.4 || ^6.0",
        "symfony/dotenv": "^5.4 || ^6.0",
        "symfony/intl": "^5.4 || ^6.0",
        "symfony/property-info": "^5.4 || ^6.0",
        "symfony/serializer": "^5.4 || ^6.0",
        "symfony/web-profiler-bundle": "^5.4 || ^6.0",
        "symfony/webpack-encore-bundle": "^1.17",
        "weirdan/doctrine-psalm-plugin": "^2.8"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusConsentManagementPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusConsentManagementPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": [
            "@ensure-test-container-exists",
            "psalm --threads=8"
        ],
        "check-style": "ecs check",
        "ensure-test-container-exists": "[[ -f tests/Application/var/cache/test/Tests_Setono_SyliusConsentManagementPlugin_Application_KernelTestDebugContainer.xml ]] || tests/Application/bin/console cache:warmup --env=test",
        "fix-style": "ecs check --fix",
        "fixtures": "(cd tests/Application && bin/console sylius:fixture:load default -n)",
        "phpunit": "phpunit"
    }
}
