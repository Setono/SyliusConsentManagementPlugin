{
    "name": "setono/sylius-consent-management-plugin",
    "type": "symfony-bundle",
    "description": "Setono example plugin for Sylius.",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "doctrine/orm": "^2.7",
        "knplabs/knp-menu": "^3.1",
        "setono/client-id-bundle": "dev-master",
        "setono/client-id-contracts": "dev-master",
        "sylius/resource-bundle": "^1.6",
        "symfony/config": "^4.4 || ^5.0",
        "symfony/dependency-injection": "^4.4 || ^5.0",
        "symfony/event-dispatcher": "^4.4 || ^5.0",
        "symfony/form": "^4.4 || ^5.0",
        "symfony/http-foundation": "^4.4 || ^5.0.7",
        "symfony/http-kernel": "^4.4 || ^5.1.5",
        "symfony/options-resolver": "^4.4 || ^5.0",
        "twig/twig": "^2.14",
        "webmozart/assert": "^1.9"
    },
    "require-dev": {
        "api-platform/core": "^2.5",
        "doctrine/data-fixtures": "^1.5",
        "doctrine/doctrine-bundle": "^1.12.13",
        "doctrine/persistence": "^1.3.8",
        "lexik/jwt-authentication-bundle": "^2.10",
        "matthiasnoback/symfony-config-test": "^4.2",
        "matthiasnoback/symfony-dependency-injection-test": "^4.2",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^9.5",
        "psalm/plugin-phpunit": "^0.15.1",
        "psalm/plugin-symfony": "^2.1",
        "roave/security-advisories": "dev-latest",
        "setono/code-quality-pack": "^2.1",
        "setono/sylius-behat-pack": "^0.2.0",
        "sylius/sylius": "~1.8.9",
        "symfony/debug-bundle": "^5.1",
        "symfony/dotenv": "^5.2",
        "symfony/intl": "^4.4 || ^5.0",
        "symfony/maker-bundle": "^1.15",
        "symfony/property-info": "^4.4 || ^5.0",
        "symfony/serializer": "^4.4 || ^5.0",
        "symfony/web-profiler-bundle": "^5.0",
        "vimeo/php-mysql-engine": "^0.5.1",
        "weirdan/doctrine-psalm-plugin": "^1.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Setono\\SyliusConsentManagementPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusConsentManagementPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyse": [
            "@ensure-test-container-exists",
            "psalm"
        ],
        "check-style": "ecs check src/ tests/",
        "ensure-test-container-exists": "[[ -f tests/Application/var/cache/test/ApplicationTests_Setono_SyliusConsentManagementPlugin_Application_KernelTestDebugContainer.xml ]] || tests/Application/bin/console cache:warmup --env=test",
        "fix-style": "ecs check src/ tests/ --fix",
        "phpunit": "phpunit"
    }
}
