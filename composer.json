{
    "name": "setono/sylius-consent-management-plugin",
    "type": "sylius-plugin",
    "description": "Setono example plugin for Sylius.",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "doctrine/orm": "^2.7",
        "knplabs/knp-menu": "^3.1",
        "matomo/device-detector": "^4.2",
        "psr/cache": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "setono/client-id-bundle": "^0.2",
        "setono/client-id-contracts": "^0.2",
        "setono/consent-contracts": "^0.1.1",
        "stof/doctrine-extensions-bundle": "^1.6",
        "sylius/resource-bundle": "^1.6",
        "symfony/config": "^4.4 || ^5.0",
        "symfony/dependency-injection": "^4.4 || ^5.0",
        "symfony/doctrine-bridge": "^4.4 || ^5.0",
        "symfony/event-dispatcher": "^4.4 || ^5.0",
        "symfony/form": "^4.4 || ^5.0",
        "symfony/http-foundation": "^4.4 || ^5.0.7",
        "symfony/http-kernel": "^4.4 || ^5.1.5",
        "symfony/options-resolver": "^4.4 || ^5.0",
        "symfony/security-bundle": "^4.4 || ^5.0",
        "symfony/translation-contracts": "^1.1 || ^2.4",
        "symfony/webpack-encore-bundle": "^1.12",
        "twig/twig": "^2.14",
        "webmozart/assert": "^1.9"
    },
    "require-dev": {
        "api-platform/core": "^2.5",
        "doctrine/data-fixtures": "^1.5",
        "egulias/email-validator": "^2.1.25",
        "friendsofsymfony/oauth-server-bundle": ">2.0.0-alpha.0 ^2.0@dev",
        "infection/infection": "^0.25.0",
        "lexik/jwt-authentication-bundle": "^2.11",
        "matthiasnoback/symfony-config-test": "^4.2",
        "matthiasnoback/symfony-dependency-injection-test": "^4.2",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^9.5",
        "psalm/plugin-phpunit": "^0.16.0",
        "psalm/plugin-symfony": "^3.0",
        "roave/security-advisories": "dev-latest",
        "setono/code-quality-pack": "^2.1.3",
        "setono/sylius-behat-pack": "^0.2.1",
        "sylius/sylius": "~1.9.4",
        "symfony/debug-bundle": "^5.3",
        "symfony/dotenv": "^5.3",
        "symfony/framework-bundle": "~5.2.0",
        "symfony/intl": "^5.3",
        "symfony/property-info": "^5.3",
        "symfony/serializer": "^5.3",
        "symfony/twig-bridge": "~5.2.0",
        "symfony/twig-bundle": "~5.2.0",
        "symfony/web-profiler-bundle": "^5.2",
        "weirdan/doctrine-psalm-plugin": "^1.1"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Setono\\SyliusConsentManagementPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusConsentManagementPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "analyse": [
            "@ensure-test-container-exists",
            "psalm"
        ],
        "check-style": "ecs check",
        "ensure-test-container-exists": "[[ -f tests/Application/var/cache/test/Tests_Setono_SyliusConsentManagementPlugin_Application_KernelTestDebugContainer.xml ]] || tests/Application/bin/console cache:warmup --env=test",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
