<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd"
>
    <class name="Setono\SyliusConsentManagementPlugin\Model\Cookie">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>name</value>
            </option>
            <option name="groups">setono_sylius_consent_management</option>
        </constraint>
        <property name="ttl">
            <constraint name="When">
                <option name="expression">!this.isSession()</option>
                <option name="constraints">
                    <constraint name="NotBlank">
                        <option name="groups">setono_sylius_consent_management</option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="service">
            <constraint name="NotBlank">
                <option name="groups">setono_sylius_consent_management</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
