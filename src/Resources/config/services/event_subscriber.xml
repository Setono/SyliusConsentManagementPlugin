<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_consent_management.event_subscriber.consent_widget_cookie"
                 class="Setono\SyliusConsentManagementPlugin\EventSubscriber\ConsentWidgetCookieSubscriber">
            <argument type="service" id="setono_sylius_consent_management.widget.consent"/>
            <argument type="service" id="setono_sylius_consent_management.cookie.consent_widget_cookie_manager"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_consent_management.event_subscriber.former_consent_platform"
                 class="Setono\SyliusConsentManagementPlugin\EventSubscriber\FormerConsentPlatformSubscriber">
            <argument type="service" id="setono_sylius_consent_management.platform.registry"/>
            <argument type="service" id="setono_sylius_consent_management.widget.consent"/>
            <argument type="service" id="setono_client_id.provider.default_client_id"/>
            <argument type="service" id="setono_sylius_consent_management.repository.consent_entry"/>
            <argument type="service" id="setono_sylius_consent_management.factory.consent_entry"/>
            <argument type="service" id="setono_sylius_consent_management.cookie.consent_widget_cookie_manager"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_consent_management.event_subscriber.new_cookies_notifier"
                 class="Setono\SyliusConsentManagementPlugin\EventSubscriber\NewCookiesNotifierSubscriber">
            <argument type="service" id="setono_sylius_consent_management.email_manager.cookie"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_consent_management.event_subscriber.check_if_visitor_is_a_bot"
                 class="Setono\SyliusConsentManagementPlugin\EventSubscriber\CheckIfVisitorIsABotSubscriber">
            <argument type="service" id="setono_sylius_consent_management.widget.consent"/>
            <argument type="service" id="setono_bot_detection.bot_detector.default"/>

            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
