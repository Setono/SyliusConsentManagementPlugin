<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusConsentManagementPlugin\Factory\CategoryFactory"
                 decorates="setono_sylius_consent_management.factory.category" decoration-priority="64">
            <argument type="service" id="Setono\SyliusConsentManagementPlugin\Factory\CategoryFactory.inner"/>
            <argument type="service" id="setono_sylius_consent_management.factory.category_translation"/>
        </service>

        <service id="Setono\SyliusConsentManagementPlugin\Factory\CategoryTranslationFactory"
                 decorates="setono_sylius_consent_management.factory.category_translation" decoration-priority="64">
            <argument type="service" id="Setono\SyliusConsentManagementPlugin\Factory\CategoryTranslationFactory.inner"/>
        </service>

        <service id="Setono\SyliusConsentManagementPlugin\Factory\ConsentEntryFactory"
                 decorates="setono_sylius_consent_management.factory.consent_entry" decoration-priority="64">
            <argument type="service" id="Setono\SyliusConsentManagementPlugin\Factory\ConsentEntryFactory.inner"/>
            <argument type="service" id="setono_sylius_consent_management.repository.category"/>
        </service>

        <service id="setono_sylius_consent_management.custom_factory.cookie"
                 class="Setono\SyliusConsentManagementPlugin\Factory\CookieFactory"
                 decorates="setono_sylius_consent_management.factory.cookie" decoration-priority="128">
            <argument type="service" id="setono_sylius_consent_management.custom_factory.cookie.inner"/>
        </service>

        <service id="setono_sylius_consent_management.custom_factory.widget_config"
                 class="Setono\SyliusConsentManagementPlugin\Factory\WidgetConfigFactory"
                 decorates="setono_sylius_consent_management.factory.widget_config" decoration-priority="128">
            <argument type="service" id="setono_sylius_consent_management.custom_factory.widget_config.inner"/>
            <argument type="service" id="sylius.repository.locale"/>
            <argument type="service" id="translator"/>
        </service>
    </services>
</container>
