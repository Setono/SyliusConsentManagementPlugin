<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <!--
        Do not edit this value on a production environment since this will
        cause the consent widget to be shown again to all users although they consented once before
        -->
        <parameter key="setono_sylius_consent_management.cookie.consent_widget">sscm_consent_widget</parameter>
    </parameters>
    <services>
        <service id="setono_sylius_consent_management.cookie.consent_widget_cookie_manager"
                 class="Setono\SyliusConsentManagementPlugin\Cookie\ConsentWidgetCookieManager">
            <argument>%setono_sylius_consent_management.cookie.consent_widget%</argument>
        </service>
    </services>
</container>
