<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusConsentManagementPlugin\Model\Cookie"
                       table="setono_sylius_consent_management__cookie">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" column="name" type="string" unique="true"/>
        <field name="url" type="string" nullable="true"/>
        <field name="state" type="string"/>
        <field name="samples" type="integer"/>
        <field name="ttl" type="string" nullable="true"/>
        <field name="session" type="boolean"/>
        <field name="lastSeenAt" type="datetime"/>

        <many-to-one target-entity="Setono\SyliusConsentManagementPlugin\Model\ServiceInterface" field="service" inversed-by="cookies">
            <join-column name="service_id" referenced-column-name="id" on-delete="SET NULL" />
        </many-to-one>

        <many-to-many field="channels" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-table name="setono_sylius_consent_management__cookie_channels">
                <join-columns>
                    <join-column name="cookie_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
                </join-columns>
                <inverse-join-columns>
                    <join-column name="channel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <field name="createdAt" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>
    </mapped-superclass>
</doctrine-mapping>
