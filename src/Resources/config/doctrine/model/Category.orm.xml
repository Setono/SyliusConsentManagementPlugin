<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusConsentManagementPlugin\Model\Category"
                       table="setono_sylius_consent_management__category">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" unique="true"/>

        <one-to-many field="services" target-entity="Setono\SyliusConsentManagementPlugin\Model\ServiceInterface" mapped-by="category"/>
    </mapped-superclass>
</doctrine-mapping>
