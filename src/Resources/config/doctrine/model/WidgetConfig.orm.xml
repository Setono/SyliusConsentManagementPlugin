<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusConsentManagementPlugin\Model\WidgetConfig"
                       table="setono_sylius_consent_management__widget_config">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="locale" target-entity="Sylius\Component\Locale\Model\LocaleInterface">
            <join-column name="locale_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <field name="heading" type="text"/>
        <field name="body" type="text"/>
        <field name="rejectButtonLabel" type="string"/>
        <field name="acceptButtonLabel" type="string"/>

        <field name="createdAt" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <unique-constraints>
            <unique-constraint columns="channel_id,locale_id"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
