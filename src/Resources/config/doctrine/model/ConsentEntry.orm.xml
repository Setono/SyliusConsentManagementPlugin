<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusConsentManagementPlugin\Model\ConsentEntry"
                       table="setono_sylius_consent_management__consent_entry">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="clientId" column="client_id" type="client_id"/>
        <field name="ip" type="string"/>
        <field name="url" type="string"/>
        <field name="userAgent" type="string"/>
        <field name="preferencesGranted" type="boolean"/>
        <field name="statisticsGranted" type="boolean"/>
        <field name="marketingGranted" type="boolean"/>

        <field name="createdAt" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <unique-constraints>
            <unique-constraint columns="client_id"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
