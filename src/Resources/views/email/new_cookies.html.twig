{# @var cookies \Setono\SyliusConsentManagementPlugin\Model\CookieInterface[] #}
{% block subject %}
    {{ 'setono_sylius_consent_management.email.new_cookies.subject'|trans() }}
{% endblock %}

{% block body %}
    <p>{{ 'setono_sylius_consent_management.email.new_cookies.greeting'|trans() }}</p>
    <p>{{ 'setono_sylius_consent_management.email.new_cookies.intro'|trans() }}</p>
    <ul>
    {% for cookie in cookies %}
        <li><a href="{{ url('setono_sylius_consent_management_admin_cookie_update', { 'id': cookie.id }) }}">{{ cookie.name }}</a></li>
    {% endfor %}
    </ul>
    <p>{{ 'setono_sylius_consent_management.email.new_cookies.instructions'|trans() }}</p>
    <p>{{ 'setono_sylius_consent_management.email.new_cookies.footer'|trans() }}</p>
{% endblock %}
