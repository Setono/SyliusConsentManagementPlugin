{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.channel) }}
            {{ form_row(form.locale) }}
        </div>
    </div>
    <div class="column">
        {{ form_row(form.heading) }}
        {{ form_row(form.body) }}

        <div class="ui two fields">
            {{ form_row(form.acceptSelectedButtonLabel) }}
            {{ form_row(form.acceptAllButtonLabel) }}
        </div>
    </div>
</div>
