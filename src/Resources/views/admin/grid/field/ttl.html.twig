{# @var \Setono\SyliusConsentManagementPlugin\Model\CookieInterface data #}
{% if data.session %}
    <em>{{ 'setono_sylius_consent_management.ui.session'|trans }}</em>
{% elseif data.ttl is null %}
    <span class="ui red label"><i class="exclamation circle icon"></i> {{ 'setono_sylius_consent_management.ui.missing'|trans }}</span>
{% else %}
    {{ data.ttl|sscm_format_date_interval }}
{% endif %}
