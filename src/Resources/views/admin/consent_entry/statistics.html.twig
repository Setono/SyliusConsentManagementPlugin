{% set time_threshold = '-30 days' %}
{% set consent_entry_count = sscm_consent_entry_count() %}
{% set consent_entry_count_last_30_days = sscm_consent_entry_count(time_threshold) %}
{% set consented_count = sscm_consented_count() %}
{% set consented_count_last_30_days = sscm_consented_count(time_threshold) %}

<div class="sscm-statistics">
    <div class="metric">
        <div class="value">{{ consent_entry_count|number_format }}</div>
        <div class="caption">{{ 'setono_sylius_consent_management.ui.consent_entries'|trans|lower }}</div>
    </div>

    <div class="metric">
        <div class="value">
            {% if consent_entry_count == 0 %}
                0%
            {% else %}
                {{ consented_count|number_format }} / {{ (consented_count / consent_entry_count * 100)|round }}%
            {% endif %}
        </div>
        <div class="caption">{{ 'setono_sylius_consent_management.ui.consented'|trans|lower }}</div>
    </div>

    <div class="metric">
        <div class="value">{{ consent_entry_count_last_30_days|number_format }}</div>
        <div class="caption">{{ 'setono_sylius_consent_management.ui.consent_entries_last_30_days'|trans|lower }}</div>
    </div>

    <div class="metric">
        <div class="value">
            {% if consent_entry_count_last_30_days == 0 %}
                0%
            {% else %}
                {{ consented_count_last_30_days|number_format }} / {{ (consented_count_last_30_days / consent_entry_count_last_30_days * 100)|round }}%
            {% endif %}
        </div>
        <div class="caption">{{ 'setono_sylius_consent_management.ui.consented_last_30_days'|trans|lower }}</div>
    </div>
</div>
