{% form_theme form '@SyliusShop/Form/theme.html.twig' %}

<div class="sscm-consent-container">
    {{ form_start(form, {'method': 'POST', 'action': path('setono_sylius_consent_management_shop_ajax_consent_widget')}) }}
        {{ form_errors(form) }}
        {{ form_row(form.preferences) }}
        {{ form_row(form.statistics) }}
        {{ form_row(form.marketing) }}

        <button type="submit" class="ui primary button">Save</button>
    {{ form_end(form) }}
</div>
