{% form_theme form '@SyliusShop/Form/theme.html.twig' %}
{% set widget_config = sscm_widget_config() %}

<div class="sscm-consent-container">
    {{ 'setono_sylius_consent_management.ui.widget.introduction'|trans({'%channel%' : sylius.channel.name}) }}

    <button type="button" class="ui button sscm-btn-more-information">{{ 'setono_sylius_consent_management.ui.widget.more_information'|trans }}</button>
    <button type="submit" class="ui primary button" form="{{ form.vars.id }}" {{ sylius_test_html_attribute('sscm-btn-submit') }}>{{ 'setono_sylius_consent_management.ui.widget.accept'|trans }}</button>
</div>
<div class="ui modal sscm-consent-modal">
    <div class="content">
        <div class="description">
            {{ form_start(form, {'method': 'POST', 'action': path('setono_sylius_consent_management_shop_ajax_consent_widget'), 'attr': {'id': form.vars.id, 'novalidate': 'novalidate'}}) }}
            {{ form_errors(form) }}

            <h4 class="ui dividing header">{{ 'setono_sylius_consent_management.ui.preferences'|trans }}</h4>
            <div class="ui two column grid">
                <div class="column">{{ form_row(form.preferencesGranted, {'label': false}) }}</div>
                <div class="column">
                    {% if services.preferences|length > 0 %}
                        {% for service in services.preferences %}
                            <p><strong>{{ service.name }}</strong><br>{{ service.description }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <h4 class="ui dividing header">{{ 'setono_sylius_consent_management.ui.marketing'|trans }}</h4>
            <div class="ui two column grid">
                <div class="column">{{ form_row(form.marketingGranted, {'label': false}) }}</div>
                <div class="column">
                    {% if services.marketing|length > 0 %}
                        {% for service in services.marketing %}
                            <p><strong>{{ service.name }}</strong><br>{{ service.description }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <h4 class="ui dividing header">{{ 'setono_sylius_consent_management.ui.statistics'|trans }}</h4>
            <div class="ui two column grid">
                <div class="column">{{ form_row(form.statisticsGranted, {'label': false}) }}</div>
                <div class="column">
                    {% if services.statistics|length > 0 %}
                        {% for service in services.statistics %}
                            <p><strong>{{ service.name }}</strong><br>{{ service.description }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <button type="submit" class="ui primary button"  {{ sylius_test_html_attribute('sscm-btn-submit') }}>{{ 'setono_sylius_consent_management.ui.widget.save'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
