{# todo all texts should come from the widget configuration #}

<div class="sscm-backdrop"></div>

<div style="position: fixed; inset: 0; z-index: 1000; width: 100vw; overflow-y: auto">
    <div style="display: flex; min-height: 100%; align-items: center; justify-content: center;">
        <div class="sscm-widget">
            <div class="sscm-heading">{{ widgetConfiguration.heading }}</div>
            <div class="sscm-body">{{ widgetConfiguration.body|markdown_to_html }}</div>
            <ul class="sscm-categories">
                {% for key, choice_form in form.consentedCategories %}
                    <li>
                        {# @var category \Setono\SyliusConsentManagementPlugin\Model\CategoryInterface #}
                        {% set category = form.consentedCategories.vars.choices[key].data %}
                        <strong>{{ category.name }}</strong><br>
                        {{ category.description }}

                        {% for service in category.services %}
                            {{ service.name }}
                        {% endfor %}
                    </li>
                {% endfor %}
            </ul>
            <div class="sscm-buttons">
                <button type="submit" data-action="reject" form="{{ form.vars.id }}" class="sscm-btn sscm-btn-reject">{{ widgetConfiguration.rejectButtonLabel }}</button>
                <button type="submit" data-action="accept" form="{{ form.vars.id }}" class="sscm-btn sscm-btn-accept">{{ widgetConfiguration.acceptButtonLabel }}</button>
            </div>
            <div style="padding: 5px 20px 20px; background-color: #f8f8f8">
                {{ form_start(form, { 'action': path('setono_sylius_consent_management_shop_update_consent'), 'attr': { 'id': form.vars.id } }) }}
                <div class="sscm-checkboxes">
                    {% for key, choice_form in form.consentedCategories %}
                        <div class="sscm-checkbox">
                            {{ form_label(choice_form) }}
                            {{ form_widget(choice_form) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
