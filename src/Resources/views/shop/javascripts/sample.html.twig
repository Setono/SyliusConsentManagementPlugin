<script>
    (async () => {
        if(typeof cookieStore !== 'object') {
            console.error("Javascript API cookieStore not supported");

            return;
        }

        const cookies = await cookieStore.getAll();
        if (cookies.length <= 0) {
            return;
        }

        await fetch("{{ path('setono_sylius_consent_management_shop_sample', { '_sample_token': token })|e('js') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify(cookies),
        });
    })();
</script>
