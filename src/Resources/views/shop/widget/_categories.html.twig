<div class="sscm-categories">
    <ul>
        {% for key, choice_form in form.consentedCategories %}
            <li>
                {# @var category \Setono\SyliusConsentManagementPlugin\Model\CategoryInterface #}
                {% set category = form.consentedCategories.vars.choices[key].data %}
                {% set services = category.services(sylius.channel) %}

                <div class="sscm-category-name">
                    <strong>{{ category.name }}</strong>
                    {% if services|length > 0 %}
                        <button type="button" data-toggle="#sscm-category-{{ category.id }}" aria-expanded="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M7.41 8.58L12 13.17l4.59-4.59L18 10l-6 6l-6-6z"/></svg>
                        </button>
                    {% endif %}
                </div>

                {{ category.description }}

                {% if services|length > 0 %}
                    <div class="sscm-services" id="sscm-category-{{ category.id }}">
                        <ul>
                            {% for service in services %}
                                {# @var service \Setono\SyliusConsentManagementPlugin\Model\ServiceInterface #}
                                {% set cookies = service.cookies(sylius.channel) %}
                                <li>
                                    <div class="sscm-service-name">
                                        {{ service.name }}
                                        {% if cookies|length > 0 %}
                                            <button type="button" data-toggle="#sscm-cookies-{{ service.id }}" aria-expanded="false">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M7.41 8.58L12 13.17l4.59-4.59L18 10l-6 6l-6-6z"/></svg>
                                            </button>
                                        {% endif %}
                                    </div>
                                    {% if service.description %}
                                        <div class="sscm-service-description">{{ service.description }}</div>
                                    {% endif %}

                                    {% if cookies|length > 0 %}
                                        <div class="sscm-cookies" id="sscm-cookies-{{ service.id }}">
                                            <table>
                                                <thead>
                                                <tr>
                                                    <th>{{ 'sylius.ui.name'|trans }}</th>
                                                    <th>{{ 'sylius.ui.description'|trans }}</th>
                                                    <th>{{ 'sylius.ui.expires_at'|trans }}</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                {% for cookie in cookies %}
                                                    {# @var cookie \Setono\SyliusConsentManagementPlugin\Model\CookieInterface #}
                                                    <tr>
                                                        <td>{{ cookie.name }}</td>
                                                        <td>{{ cookie.description ?? 'Not available' }}</td>
                                                        <td>
                                                            {% if cookie.session %}
                                                                <em>Session</em>
                                                            {% else %}
                                                                {{ cookie.ttl|sscm_format_date_interval }}
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</div>
