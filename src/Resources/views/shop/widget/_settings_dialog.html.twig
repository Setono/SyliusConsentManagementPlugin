{% form_theme form '@SyliusShop/Form/theme.html.twig' %}

<div id="sscm-settings-dialog">
    <div id="sscm-wm-box" tabindex="0">
        {{ form_start(form, {'attr': {'id': form.vars.id, 'novalidate': 'novalidate'}}) }}
        <div id="sscm-wmb-top">
            <div id="sscm-wmbt-title">{{ 'setono_sylius_consent_management.ui.widget.settings'|trans }}</div>
            <button type="submit" class="sscm-button-green" id="sscm-wmbt-save" {{ sylius_test_html_attribute('sscm-btn-submit') }}>{{ 'setono_sylius_consent_management.ui.widget.save'|trans }}</button>
        </div>
        {% include '@SetonoSyliusConsentManagementPlugin/shop/common/_form.html.twig' %}
        {{ form_end(form) }}
    </div>
</div>
