<div id="sscm-initial-dialog">
    <div class="sscm-description">{{ sscm_widget_config().usageDescription }}</div>
    <div class="sscm-buttons">
        <button id="sscm-button-accept" class="sscm-button sscm-button-primary" type="submit" form="{{ form.vars.id }}" {{ sylius_test_html_attribute('sscm-btn-submit') }}>{{ 'setono_sylius_consent_management.ui.widget.accept'|trans }}</button>
        <button id="sscm-button-more" class="sscm-button  sscm-button-secondary" type="button">{{ 'setono_sylius_consent_management.ui.widget.more_information'|trans }}</button>
    </div>
</div>
