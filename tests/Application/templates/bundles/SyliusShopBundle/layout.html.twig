<!DOCTYPE html>
<html lang="{{ app.request.locale|slice(0, 2) }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">

        <title>{% block title %}{{ sylius.channel.name }}{% endblock %}</title>

        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

        {% block metatags %}
        {% endblock %}

        {% block stylesheets %}
            {{ sylius_template_event('sylius.shop.layout.stylesheets') }}
        {% endblock %}

        {{ sylius_template_event('sylius.shop.layout.head') }}

        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-KJHCKT9');</script>
        <!-- End Google Tag Manager -->

        {{ sscm_resources() }}
    </head>
    <body class="pushable">
        {{ sylius_template_event('sylius.shop.layout.before_body') }}
        <div class="pusher">
            {% block top %}
                <div id="menu" class="ui large sticky inverted stackable menu">
                    {{ sylius_template_event('sylius.shop.layout.topbar') }}
                </div>
            {% endblock %}

            <div class="ui container">
                {% block header %}
                    <header>
                        {{ sylius_template_event('sylius.shop.layout.header') }}
                    </header>
                {% endblock %}

                {% include '@SyliusShop/_flashes.html.twig' %}

                {{ sylius_template_event('sylius.shop.layout.before_content') }}
                {% block content %}
                {% endblock %}

                {{ sylius_template_event('sylius.shop.layout.after_content') }}
            </div>

            {% block footer %}
                {% include '@SyliusShop/_footer.html.twig' %}
            {% endblock %}
        </div>

        {% block javascripts %}
            {{ sylius_template_event('sylius.shop.layout.javascripts') }}

            {{ sscm_script_tag(asset('js/functional.js'), 'functional') }}
            {{ sscm_script_tag(asset('js/marketing.js'), 'marketing') }}
            {{ sscm_script_tag(asset('js/statistical.js'), 'statistical') }}

            {# The src comes from the attribute here, not from data-sscm-src. The activated script must keep the attributes #}
            <script id="script-with-attributes" src="{{ asset('js/script-with-attributes.js') }}" crossorigin="anonymous" data-test="kept"{{ sscm_script_tag_attributes('marketing') }}></script>

            <script{{ sscm_script_tag_attributes('functional') }}>
                console.info('Inline script: Functional granted');
            </script>
            <script{{ sscm_script_tag_attributes('marketing') }}>
                console.info('Inline script: Marketing granted');
            </script>
            <script{{ sscm_script_tag_attributes('statistical') }}>
                console.info('Inline script: Statistical granted');
            </script>

            {# Runs before the consent manager exists, so it waits for the ready event #}
            <script>
                document.addEventListener('sscm:ready', () => {
                    window.consentedCategoriesWhenReady = window.sscmManager.getConsentedCategories();
                });
            </script>
            {# Activated by the consent manager on page load, like a consent-gated script on a cached page #}
            <script type="text/plain" data-sscm-consent="necessary">
                window.necessaryGrantedWhenActivated = window.sscmManager.isGranted('necessary');
            </script>
        {% endblock %}

        {% include '@SyliusUi/Modal/_confirmation.html.twig' %}
        {{ sylius_template_event('sylius.shop.layout.after_body') }}
        {{ sscm_widget() }}
    </body>
</html>
